<UserControl x:Class="DuoLaBox.Views.ColorPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="取色器"/>
                <TextBlock Margin="0,7,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="从屏幕任意位置取色，复制常用格式并收藏颜色。"/>
            </StackPanel>
            <Button x:Name="PickColorButton"
                    Grid.Column="1"
                    MinWidth="118"
                    VerticalAlignment="Center"
                    Click="PickColorButton_Click"
                    Style="{StaticResource SkyBlueButtonStyle}"
                    Content="开始取色"/>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CurrentColorSwatch"
                                Width="116"
                                Height="116"
                                Background="#1689D8"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"/>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="当前颜色"/>
                            <TextBlock x:Name="CurrentHexText"
                                       Margin="0,6,0,12"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Text="#1689D8"/>
                            <Button HorizontalAlignment="Left"
                                    Click="FavoriteCurrentButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="收藏当前颜色"/>
                            <TextBlock x:Name="OperationStatusText"
                                       Margin="0,9,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="2,18,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="颜色格式"/>
                <ItemsControl x:Name="FormatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="16,11"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               Text="{Binding Value}"/>
                                    <Button Grid.Column="2"
                                            Tag="{Binding Value}"
                                            Click="CopyButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="复制"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="2,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="收藏的颜色"/>
                    <TextBlock x:Name="FavoriteEmptyText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="还没有收藏"/>
                </Grid>
                <ItemsControl x:Name="FavoriteList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"/>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               Text="{Binding Hex}"/>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal">
                                        <Button Padding="9,5"
                                                Tag="{Binding Hex}"
                                                ToolTip="{Binding Hex}"
                                                Click="CopyButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="HEX"/>
                                        <Button Margin="6,0,0,0"
                                                Padding="9,5"
                                                Tag="{Binding Rgb}"
                                                ToolTip="{Binding Rgb}"
                                                Click="CopyButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="RGB"/>
                                        <Button Margin="6,0,0,0"
                                                Padding="9,5"
                                                Tag="{Binding Hsl}"
                                                ToolTip="{Binding Hsl}"
                                                Click="CopyButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="HSL"/>
                                        <Button Margin="6,0,0,0"
                                                Padding="9,5"
                                                Tag="{Binding Hsv}"
                                                ToolTip="{Binding Hsv}"
                                                Click="CopyButton_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="HSV"/>
                                    </StackPanel>
                                    <Button Grid.Column="4"
                                            Tag="{Binding Hex}"
                                            Click="RemoveFavoriteButton_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="删除"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
