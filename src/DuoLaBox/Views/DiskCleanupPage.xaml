<UserControl x:Class="DuoLaBox.Views.DiskCleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid x:Name="CleanupPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="C 盘一键清理"/>
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="按清理库扫描可清理文件，预览确认后释放磁盘空间。"/>
                </StackPanel>
                <ComboBox x:Name="CleanupSortComboBox"
                          Grid.Column="1"
                          Width="132"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="CleanupSortComboBox_SelectionChanged"
                          Style="{StaticResource SettingsComboBoxStyle}">
                    <ComboBoxItem Content="按名称排序"/>
                    <ComboBoxItem Content="按文件大小排序"/>
                </ComboBox>
                <Button x:Name="ScanButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Click="ScanButton_Click"
                        Style="{StaticResource SkyBlueButtonStyle}"
                        Content="开始扫描"/>
                <Button Grid.Column="5"
                        VerticalAlignment="Center"
                        Click="EditLibraryButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="编辑清理库"/>
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,13"
                    Background="{DynamicResource AccentSubtleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="CandidateCountText"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="0"/>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="可清理文件"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource BorderBrush}"/>
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="CleanupSizeText"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="0 B"/>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="预计释放"/>
                    </StackPanel>
                    <Border Grid.Column="3"
                            Background="{DynamicResource BorderBrush}"/>
                    <StackPanel Grid.Column="4"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="InvalidRuleCountText"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="0"/>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="无效规则"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListView x:Name="CandidateList"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected,
                                                  Mode=TwoWay}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Path}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Rule}"
                                                   Text="{Binding DisplayExplanation}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Width="92"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextAlignment="Right"
                                               Typography.NumeralAlignment="Tabular"
                                               Text="{Binding DisplaySize}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="CleanupEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="34"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="&#xE74D;"/>
                        <TextBlock x:Name="CleanupEmptyTitleText"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="尚未扫描"/>
                        <TextBlock x:Name="CleanupEmptyDescriptionText"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="扫描不会删除任何文件。"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Padding="14,11"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CleanupStatusTitleText"
                                   FontWeight="SemiBold"
                                   Text="清理状态"/>
                        <TextBlock x:Name="CleanupStatusText"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="清理库尚未扫描。"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="CleanSelectedButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Click="CleanSelectedButton_Click"
                            Style="{StaticResource SkyBlueButtonStyle}"
                            Content="清理选中项目"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="LibraryPanel"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Width="36"
                        Height="36"
                        Click="BackToCleanupButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="←"/>
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="清理库"/>
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="按分类维护清理范围和说明；每行一个路径或通配规则。"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="13,10"
                    Background="{DynamicResource AccentSubtleBrush}"
                    CornerRadius="7">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="警告：自定义规则可以指向任意文件，请只导入可信来源并逐项核对预览。以 # 开头的内容是说明；支持环境变量、* 单层通配和 ** 跨目录通配。默认库会避开个人文件和关键系统组件。"/>
            </Border>

            <TextBox x:Name="LibraryTextBox"
                     Grid.Row="4"
                     Padding="12"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     TextWrapping="NoWrap"
                     Style="{StaticResource SearchBoxStyle}"/>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LibraryStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Button Grid.Column="1"
                        Click="ImportLibraryButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="导入规则文件"/>
                <Button Grid.Column="3"
                        Click="RestoreLibraryButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="恢复默认"/>
                <Button Grid.Column="5"
                        Click="SaveLibraryButton_Click"
                        Style="{StaticResource SkyBlueButtonStyle}"
                        Content="保存清理库"/>
            </Grid>
        </Grid>

        <Grid x:Name="CleanupConfirmBorder"
              Background="#66000000"
              Visibility="Collapsed">
            <Grid Width="430"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          Opacity="0.28"
                                          ShadowDepth="5"/>
                    </Border.Effect>
                </Border>
                <Border Padding="22"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        TextOptions.TextFormattingMode="Display"
                        TextOptions.TextRenderingMode="ClearType">
                    <StackPanel>
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="确认清理选中的文件？"/>
                        <TextBlock x:Name="CleanupConfirmText"
                                   Margin="0,9,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,9,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="清理后的文件不会进入回收站。"/>
                        <StackPanel Margin="0,20,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Click="CancelCleanupButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="取消"/>
                            <Button Click="ConfirmCleanupButton_Click"
                                    Style="{StaticResource SkyBlueButtonStyle}"
                                    Content="确认清理"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
