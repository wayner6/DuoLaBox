<UserControl x:Class="DuoLaBox.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:DuoLaBox"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="设置"/>
            <TextBlock Margin="0,7,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="调整 DuoLaBox 的启动、外观和关闭行为。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Padding="20,18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="登录 Windows 后自动启动"/>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="登录当前账户后自动运行 DuoLaBox。"/>
                    </StackPanel>
                    <ToggleButton x:Name="StartWithWindowsToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Click="StartWithWindowsToggle_Click"
                                  Content="关"
                                  Style="{StaticResource SettingToggleStyle}"/>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="20,18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="启动时静默启动"/>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="启动应用时仅进入系统托盘，不显示前台窗口。"/>
                    </StackPanel>
                    <ToggleButton x:Name="SilentStartupToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Click="SilentStartupToggle_Click"
                                  Content="关"
                                  Style="{StaticResource SettingToggleStyle}"/>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="20,18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="颜色模式"/>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="选择固定主题，或跟随 Windows 系统设置。"/>
                    </StackPanel>
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              Style="{StaticResource SettingsComboBoxStyle}">
                        <ComboBoxItem Content="浅色主题" Tag="Light"/>
                        <ComboBoxItem Content="深色主题" Tag="Dark"/>
                        <ComboBoxItem Content="跟随系统主题" Tag="FollowSystem"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="20,18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="关闭主窗口时"/>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="选择保留后台功能，或彻底退出应用。"/>
                    </StackPanel>
                    <ComboBox x:Name="CloseBehaviorComboBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              SelectionChanged="CloseBehaviorComboBox_SelectionChanged"
                              Style="{StaticResource SettingsComboBoxStyle}">
                        <ComboBoxItem Content="保留在系统托盘" Tag="Tray"/>
                        <ComboBoxItem Content="直接关闭" Tag="Exit"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Margin="0,12,0,4"
                    Padding="20,18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="关于"/>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{x:Static app:AppIdentity.Tagline}"/>
                        <TextBlock x:Name="VersionText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="164"
                            Height="38"
                            Click="GithubButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons"
                                       Text="&#xE71B;"/>
                            <TextBlock Text="GitHub · wayner6"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
