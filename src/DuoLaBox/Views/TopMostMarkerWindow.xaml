<Window x:Class="DuoLaBox.Views.TopMostMarkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="38"
        Height="24"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        SourceInitialized="Window_SourceInitialized">
    <Button AutomationProperties.Name="取消置顶"
            Click="MarkerButton_Click"
            Cursor="Hand"
            Focusable="False"
            ToolTip="取消置顶">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="MarkerBorder"
                        Background="#E60067C0"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13"
                               Foreground="White"
                               Text="&#xE718;"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="MarkerBorder"
                                Property="Background"
                                Value="#FF005A9E"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="MarkerBorder"
                                Property="Opacity"
                                Value="0.78"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
