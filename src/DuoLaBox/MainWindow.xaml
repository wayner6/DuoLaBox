<Window x:Class="DuoLaBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DuoLaBox"
        xmlns:models="clr-namespace:DuoLaBox.Models"
        xmlns:views="clr-namespace:DuoLaBox.Views"
        Title="DuoLaBox"
        Icon="{StaticResource AppVectorIcon}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Width="1060"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="8,12,8,0"
                            Orientation="Horizontal">
                    <Border Width="36"
                            Height="36"
                            Background="Transparent"
                            CornerRadius="8">
                        <Image Width="36"
                               Height="36"
                               Source="{StaticResource AppVectorIcon}"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="DuoLaBox"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{x:Static local:AppIdentity.Tagline}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="WindowToolsNavButton"
                            Background="{DynamicResource NavigationSelectedBrush}"
                            Tag="Selected"
                            Click="WindowToolsNavButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE840;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="窗口置顶"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DayNightNavButton"
                            AutomationProperties.Name="打开系统修改"
                            Click="DayNightNavButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE706;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="系统修改"/>
                        </Grid>
                    </Button>
                    <Button x:Name="FileBatchNavButton"
                            AutomationProperties.Name="打开文件批量处理"
                            Click="FileBatchNavButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE8B7;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="文件批量处理"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DiskCleanupNavButton"
                            AutomationProperties.Name="打开C盘一键清理"
                            Click="DiskCleanupNavButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE74D;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="C 盘一键清理"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ColorPickerNavButton"
                            AutomationProperties.Name="打开取色器"
                            Click="ColorPickerNavButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE790;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="取色器"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SystemInformationNavButton"
                            AutomationProperties.Name="打开系统信息"
                            Click="SystemInformationNavButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE950;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="系统信息"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsNavButton"
                            AutomationProperties.Name="打开设置"
                            Click="SettingsButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE713;"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="设置"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="8">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="更多工具将在这里出现"/>
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               Text="版本"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
        <Grid x:Name="WindowToolsPage" Margin="38,30,42,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="窗口置顶"/>
                <TextBlock Margin="0,7,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="让重要窗口始终显示在其他窗口上方。"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="14,12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSubtleBrush}"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="&#xE8B0;"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="鼠标点击置顶"/>
                        <TextBlock x:Name="PickerStatusText"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="点击按钮，再点击目标窗口的顶部区域。"/>
                    </StackPanel>

                    <Button x:Name="MousePickButton"
                            Grid.Column="3"
                            MinWidth="122"
                            AutomationProperties.Name="开始鼠标点击选择"
                            Click="MousePickButton_Click"
                            Style="{StaticResource SkyBlueButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       FontFamily="Segoe Fluent Icons"
                                       Text="&#xE840;"/>
                            <TextBlock x:Name="MousePickButtonText"
                                       Text="开始选择"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint"
                           Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           Text="搜索窗口或应用名称"/>
            </Grid>

            <Border Grid.Row="6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListView x:Name="WindowList"
                              Margin="0,4"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WindowInfo}">
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentSubtleBrush}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Image x:Name="WindowIcon"
                                                       Width="28"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="{Binding Icon}"
                                                       Stretch="Uniform"/>
                                                <TextBlock x:Name="FallbackWindowIcon"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="17"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="&#xE8A7;"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock MaxWidth="460"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>
                                            <StackPanel Margin="0,3,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding DisplayProcessName}"/>
                                                <TextBlock Margin="7,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                                           Text="·"/>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding StatusText}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="3"
                                                      MinWidth="100"
                                                      VerticalAlignment="Center"
                                                      Click="TopMostButton_Click"
                                                      Content="{Binding ActionText}"
                                                      IsChecked="{Binding IsTopMost, Mode=OneWay}"
                                                      Style="{StaticResource SettingToggleStyle}"
                                                      Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}"
                                             Value="{x:Null}">
                                    <Setter TargetName="WindowIcon"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                    <Setter TargetName="FallbackWindowIcon"
                                            Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="36"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="&#xE7BA;"/>
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="未找到可用窗口"/>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="请打开目标窗口后刷新，或尝试其他搜索词。"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="7" Margin="2,12,2,0">
                <TextBlock x:Name="WindowCountText"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </Grid>

        <views:SettingsPage x:Name="SettingsPage"
                            Margin="38,30,42,32"
                            Visibility="Collapsed"/>
        <views:SystemToolsPage x:Name="SystemToolsPage"
                               Margin="38,30,42,32"
                               Visibility="Collapsed"/>
        <views:FileBatchPage x:Name="FileBatchPage"
                             Margin="38,30,42,32"
                             Visibility="Collapsed"/>
        <views:ColorPickerPage x:Name="ColorPickerPage"
                               Margin="38,30,42,32"
                               Visibility="Collapsed"/>
        <views:DiskCleanupPage x:Name="DiskCleanupPage"
                               Margin="38,30,42,32"
                               Visibility="Collapsed"/>
        <views:SystemInformationPage x:Name="SystemInformationPage"
                                     Margin="38,30,42,32"
                                     Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

